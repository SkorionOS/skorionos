#!/bin/bash

configure_resolver() {
	local resolver="$1"
	local target="$2"
	local backup="${resolver}.skorionos-backup"

	if ! systemctl is-enabled --quiet systemd-resolved.service; then
		echo "dns-resolver-setup: systemd-resolved.service not enabled; preserving '$resolver'" >&2
		return 0
	fi

	if ! systemctl is-active --quiet systemd-resolved.service; then
		echo "dns-resolver-setup: systemd-resolved.service not active; preserving '$resolver'" >&2
		return 0
	fi

	if [ ! -e "$target" ] || [ ! -r "$target" ]; then
		echo "dns-resolver-setup: resolver target '$target' missing or unreadable; preserving '$resolver'" >&2
		return 0
	fi

	if [ -d "$resolver" ] && [ ! -L "$resolver" ]; then
		echo "dns-resolver-setup: '$resolver' is a directory; refusing to replace" >&2
		return 1
	fi

	# Promote native enablement and aliases into the writable /etc layer before
	# inspecting or backing up state; image-owned lower links cannot satisfy this.
	if ! systemctl reenable --no-reload systemd-resolved.service; then
		echo "dns-resolver-setup: failed to reenable systemd-resolved.service; not switching" >&2
		return 1
	fi

	# Touch existing config files so their current content copies up into the
	# persistent overlay; do not alter contents and do not follow user symlinks.
	local etc_dir
	etc_dir=$(dirname "$resolver")
	local nm_conf="$etc_dir/NetworkManager/conf.d/20-systemd-resolved.conf"
	local resolved_conf="$etc_dir/systemd/resolved.conf.d/20-skorionos.conf"
	local f
	for f in "$nm_conf" "$resolved_conf"; do
		if [ -f "$f" ] && [ ! -L "$f" ]; then
			if ! touch "$f"; then
				echo "dns-resolver-setup: failed to touch '$f'; not switching" >&2
				return 1
			fi
		fi
	done

	if [ -L "$resolver" ] && [ "$(readlink "$resolver")" = "$target" ]; then
		if ! systemctl disable --no-reload skorion-dns-resolver.service; then
			echo "dns-resolver-setup: failed to disable skorion-dns-resolver.service" >&2
			return 1
		fi
		return 0
	fi

	if { [ -e "$resolver" ] || [ -L "$resolver" ]; } && [ ! -e "$backup" ] && [ ! -L "$backup" ]; then
		if ! cp -a --no-dereference "$resolver" "$backup"; then
			echo "dns-resolver-setup: failed to back up '$resolver'; not switching" >&2
			return 1
		fi
	fi

	ln -sfnT "$target" "$resolver" || {
		echo "dns-resolver-setup: failed to link '$resolver' to '$target'" >&2
		return 1
	}

	if ! systemctl disable --no-reload skorion-dns-resolver.service; then
		echo "dns-resolver-setup: failed to disable skorion-dns-resolver.service" >&2
		return 1
	fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	configure_resolver /etc/resolv.conf /usr/lib/systemd/resolv.conf
fi
